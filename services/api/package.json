{
  "name": "@slate/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test test/unit.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration.test.ts",
    "maintenance": "tsx src/maintenance.ts",
    "demo:media": "tsx prisma/demo-media.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@hono/node-server": "^1.19.0",
    "@prisma/client": "^6.19.0",
    "dotenv": "^17.2.0",
    "hono": "^4.10.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "deepmerge-ts": "^8.0.2",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "$deepmerge-ts"
  }
}
